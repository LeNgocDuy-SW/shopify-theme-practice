<div class="faq">
  {% if section.settings.title != blank %}
    <h2 class="faq__title">{{ section.settings.title }}</h2>
  {% endif %}

  {% for block in section.blocks %}
    <details class="faq__item" {{ block.shopify_attributes }}>
      <summary class="faq__question">{{ block.settings.question }}</summary>
      <div class="faq__answer">{{ block.settings.answer }}</div>
    </details>
  {% else %}
    <p class="faq__empty">Hãy thêm câu hỏi đầu tiên trong Theme editor.</p>
  {% endfor %}
</div>

{% stylesheet %}
  .faq { max-width: 720px; margin: 0 auto; padding: 40px 24px; }
  .faq__title { text-align: center; margin: 0 0 24px; }
  .faq__item { border-bottom: 1px solid #ddd; padding: 16px 0; }
  .faq__question { cursor: pointer; font-weight: 600; }
  .faq__answer { margin-top: 12px; }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Câu hỏi thường gặp" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Câu hỏi",
      "settings": [
        { "type": "text", "id": "question", "label": "Câu hỏi", "default": "Bao lâu thì nhận được hàng?" },
        { "type": "richtext", "id": "answer", "label": "Câu trả lời", "default": "<p>Thông thường từ 3 đến 5 ngày làm việc.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}