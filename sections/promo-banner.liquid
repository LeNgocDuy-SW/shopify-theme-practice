<div class="promo-banner promo-banner--{{ section.settings.font_size }}" style="background: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.subtext }}</p>
  {% if section.settings.show_button and section.settings.button_label != blank %}
    <a href="{{ section.settings.button_link }}" class="promo-banner__button">
      {{ section.settings.button_label }}
    </a>
  {% endif %}
</div>

{% stylesheet %}
  .promo-banner {
    padding: 48px 24px;
    text-align: center;
  }
  .promo-banner h2 {
    margin: 0 0 8px;
  }
  .promo-banner--small h2 { font-size: 20px; }
  .promo-banner--medium h2 { font-size: 32px; }
  .promo-banner--large h2 { font-size: 48px; }
  .promo-banner__button {
    display: inline-block;
    margin-top: 16px;
    padding: 12px 28px;
    background: #fff;
    color: #111;
    text-decoration: none;
    border-radius: 4px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Giảm giá 20% toàn bộ cửa hàng" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Chỉ trong tuần này" },
    {
      "type": "select",
      "id": "font_size",
      "label": "Heading size",
      "options": [
        { "value": "small", "label": "Nhỏ" },
        { "value": "medium", "label": "Vừa" },
        { "value": "large", "label": "Lớn" }
      ],
      "default": "medium"
    },
    { "type": "checkbox", "id": "show_button", "label": "Show button", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Mua ngay" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#111111" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" }
  ],
  "presets": [{ "name": "Promo banner" }]
}
{% endschema %}